# IDE and local runtime files
.idea/
__pycache__/
*.py[cod]

# Ultralytics caches and temporary training artifacts
*.cache
labels/*.cache
labels/**/*.cache
exports/**/*.cache

# Raw capture data and full external downloads are intentionally not versioned.
# Keep source notes under external/ available in the repository.
raw/
external/**
!external/
!external/SOURCES.md

# Keep only curated training outputs.
runs/**
!runs/
!runs/RUNS_INDEX.md
!runs/runs2/
!runs/runs2/segment/
